# ChartRead Environment Configuration
# ==============================================================================
# Optional OpenSearch / Elasticsearch Cloud Sync
# If left blank, ChartRead automatically runs in 100% offline local storage mode
# and saves all layouts, drawings, and preferences to local disk.
# ==============================================================================

OPENSEARCH_HOST=
OPENSEARCH_PORT=12445
OPENSEARCH_USER=
OPENSEARCH_PASS=
OPENSEARCH_PROTOCOL=https
